# ==============================================================================
# SlayQL Enterprise Demo Configuration
# ==============================================================================

# Application Environment (demo | production)
APP_ENV=demo
DEBUG=false
LOG_LEVEL=INFO

# Frontend API prefix. Leave unset for same-origin VPS/Caddy hosting. For a
# Vercel frontend, set this to the public API prefix, for example:
# VITE_API_BASE_URL=https://fyp.kianlok.top/api/v1

# AI provider (OpenAI-compatible chat API): opentk (development default) or together.
LLM_PROVIDER=opentk
# OpenTK testing environment: deepseek-v4.1-flash (default) and glm-5.3. No published prices.
OPENTK_KEY=your_opentk_key_here
# Together AI: deepseek-ai/DeepSeek-V4-Flash-0731 and moonshotai/Kimi-K3. TOGETHER_AI_KEY also works.
TOGETHER_API_KEY=
# Optional overrides; empty means the provider's own URL and first model.
LLM_BASE_URL=
EXECUTION_MODEL=

# Outgoing email: weekly report packs and answers from the review queue. Gmail with a
# Google App Password by default (smtp.gmail.com:587). SMTP_USER/SMTP_PASSWORD also work.
EMAIL=
APP_PASS=
# Email askers when an analyst answers their question (off unless true).
EMAIL_NOTIFICATIONS=false
# Send scheduled report emails from this server (checked every 5 minutes).
REPORT_SCHEDULER=true
# Where links in emails point, e.g. https://your-domain.
PUBLIC_APP_URL=http://localhost:5173

# Direct Model Provider API Keys (Optional fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Database Workbench AI (all workbench agents are locked to gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Backend Persistence
# Use the PostgreSQL URI from Supabase Connect, not the project REST URL or
# anon key. Backend tables are isolated in BACKEND_DATABASE_SCHEMA.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
BACKEND_DATABASE_SCHEMA=slayql

# Local query demo fallback (used only when DATABASE_URL is absent)
SQLITE_DEMO_PATH=backend/data/slayql_demo.sqlite3
DEMO_POSTGRES_URL=

# Data-source persistence and encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# SQLite fallback for backend persistence when DATABASE_URL is absent.
CONTROL_DB_PATH=backend/data/slayql_control.sqlite3
CONNECTION_DATA_DIR=backend/data/connections

# Safety Guardrails and Limits
MAX_ACTIVE_RUNS=5
QUERY_TIMEOUT_SECONDS=10.0
MAX_RESULT_ROWS=200
