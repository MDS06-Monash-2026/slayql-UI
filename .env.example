# ==============================================================================
# SlayQL Enterprise Demo Configuration
# ==============================================================================

# Application Environment (demo | production)
APP_ENV=demo
DEBUG=false
LOG_LEVEL=INFO

# OpenRouter AI Gateway (Recommended - single key for all models)
OPENROUTER_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=deepseek/deepseek-v4-flash

# Direct Model Provider API Keys (Optional fallbacks)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Database Workbench AI (all workbench agents are locked to gemini-3.5-flash-lite)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Backend Persistence
# Use the PostgreSQL URI from Supabase Connect, not the project REST URL or
# anon key. Backend tables are isolated in BACKEND_DATABASE_SCHEMA.
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres?sslmode=require
BACKEND_DATABASE_SCHEMA=slayql

# Local query demo fallback (used only when DATABASE_URL is absent)
SQLITE_DEMO_PATH=backend/data/slayql_demo.sqlite3
DEMO_POSTGRES_URL=

# Data-source persistence and encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# SQLite fallback for backend persistence when DATABASE_URL is absent.
CONTROL_DB_PATH=backend/data/slayql_control.sqlite3
CONNECTION_DATA_DIR=backend/data/connections

# Safety Guardrails and Limits
MAX_ACTIVE_RUNS=5
QUERY_TIMEOUT_SECONDS=10.0
MAX_RESULT_ROWS=200
